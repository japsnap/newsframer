# NewsFramer — environment template
# Copy this file to `.env` and fill in real values.
# The real `.env` is gitignored and must NEVER be committed.
# Do not paste real keys into chat with an AI assistant — it does not need them.

# --- Supabase (data layer: Postgres + pgvector) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- LLM provider keys (consumed by LiteLLM per config/models.yaml) ---
# Gemini models ("gemini/...") — Google AI Studio key
GEMINI_API_KEY=your-google-ai-studio-key
# Anthropic models ("anthropic/...") — Claude key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Telegram delivery (agents/dispatcher.py) ---
TELEGRAM_BOT_TOKEN=000000000:your-telegram-bot-token
TELEGRAM_CHAT_ID=your-numeric-telegram-chat-id

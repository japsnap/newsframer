# NewsFramer — environment template.
# Copy this file to `.env` (which is gitignored) and fill in each value on your own machine.
# NEVER commit `.env`. NEVER paste a real key into a chat with an AI assistant — it does not need it.
# This template lists NAMES only; there are no values here on purpose.

# ---------------------------------------------------------------------------
# REQUIRED — the pipeline will not run without these.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase service_role key (server-side, full DB access). Keep it secret.
SUPABASE_SERVICE_KEY=

# Google AI Studio key for Gemini — the cheap classify/analyze/embed/title-dedup stages (via LiteLLM).
GEMINI_API_KEY=

# Telegram bot token (delivery + the watchdog's direct alerts). From @BotFather.
TELEGRAM_BOT_TOKEN=

# Your own Telegram chat id — the brief's recipient.
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# OPTIONAL — features degrade gracefully if these are unset.
# ---------------------------------------------------------------------------

# Anthropic key for Claude synthesis (the writer). OPTIONAL: only needed if the writer uses the
# metered Anthropic API. If you run the writer on a flat Claude subscription (claude -p) instead,
# leave this blank. On any Anthropic error the writer falls back to Gemini.
ANTHROPIC_API_KEY=

# Firecrawl key for the JS-heavy / non-RSS scrape fallback. OPTIONAL: without it, browser_required
# sources are simply skipped; all RSS sources still work.
FIRECRAWL_API_KEY=

# Name of the OpenClaw gateway scheduled task the watchdog checks. OPTIONAL: defaults to a config
# value ("OpenClaw Gateway") when unset.
OPENCLAW_GATEWAY_TASK=

# ---------------------------------------------------------------------------
# ADVANCED — optional runtime overrides. Every one has a safe in-code default; leave them unset
# unless you specifically need to tune behavior. They are documented here only for completeness.
# ---------------------------------------------------------------------------

# deliveries.account label for the Telegram brief (default: newsframer).
NEWSFRAMER_DELIVERY_ACCOUNT=
# Gateway channel account id for Telegram sends (default: newsframer).
NEWSFRAMER_TG_ACCOUNT=
# How many hours a brief stays "fresh" for delivery/printing (default: 20).
NEWSFRAMER_BRIEF_FRESH_HOURS=
# Deliver-step wait / poll seconds before sending (defaults from config/models.yaml).
NEWSFRAMER_DELIVER_WAIT_SECONDS=
NEWSFRAMER_DELIVER_POLL_SECONDS=
# How many recent briefs deliver_brief scans to pick the freshest (default: 10).
NEWSFRAMER_BRIEF_SCAN=
# Caps the per-source fetch window in hours for the WhatsApp gap-refresh (set by code at runtime).
NEWSFRAMER_MAX_FETCH_WINDOW_HOURS=
# Dump the cc_writer prompt to a file for debugging (set to a path). Off when unset.
NEWSFRAMER_CC_DUMP=

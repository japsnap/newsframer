# 絶対にGitHubにあげてはいけないもの
.env
*.env
.env.*
# keep the template (placeholders only) trackable
!.env.example

# Local agent/Codex context and settings — local-only, never committed
CLAUDE.md
AGENTS.md
.codex/

# Keys / certs — never commit
.key
*.key
.pem
*.pem

# Python
venv/
__pycache__/
*.pyc
*.pyo

# ログ・一時ファイル
*.log
*.tmp

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/

# Real local config — *.example.* templates are committed; real instances stay local
user_context.json
config/whatsapp_deliveries.yaml

# Private backlog — never commit
BACKLOG.md

# Local SQLite scratch / debug DBs — never commit (the real data layer is Supabase)
*.db

# Drop-report local store (spec §8.5) — runtime data, regenerated per brief
data/drop_reports/

# Local audit notes + leftover cloud/scratch files — local-only, never committed
CODEX_AUDIT.md
codex_findings_rc.md
Dockerfile
.claude/

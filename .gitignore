# 絶対にGitHubにあげてはいけないもの
.env
*.env
.env.*
# keep the template (placeholders only) trackable
!.env.example

# Keys / certs — never commit
.key
*.key
.pem
*.pem

# Python
venv/
__pycache__/
*.pyc
*.pyo

# ログ・一時ファイル
*.log
*.tmp

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/

# Real local config — *.example.* templates are committed; real instances stay local
user_context.json
